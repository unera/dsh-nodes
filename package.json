{
  "name": "@dr-co/dsh-nodes",
  "version": "0.3.19",
  "description": "Run commands on remote machines from a DSH session: sandboxed (ro/rw/full), policy-controlled, audited",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/",
    "spec/",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test --test-timeout=180000 test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "nodes",
    "remote",
    "mcp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unera/dsh-nodes.git"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "yaml": "^2.9.1"
  }
}
